{
    "name": "almapay/alma-monthlypayments-magento2",
    "description": "Integrates Alma Monthly Payments into Magento 2",
    "require": {
        "php": ">=7.1",
        "alma/alma-php-client": "^2.6"
    },
    "type": "magento2-module",
    "version": "5.9.0",
    "license": [
        "MIT"
    ],
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Alma\\MonthlyPayments\\": ""
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        }
    ],
    "require-dev": {
        "mockery/mockery": "^1.3",
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
